# Incentive Tracker settings for the office server.
# Copy to /opt/incentive/.env, run `chmod 600 .env`, then fill in the values with nano.
# Never commit the real .env, and never paste it into chat or show it in a screenshot.

# --- First administrator -------------------------------------------------------------------------
# Used only on the very first start, when the database is empty. After you have signed in you can
# delete the ADMIN_PASSWORD line; change the password any time from Team > key icon.
ADMIN_EMAIL=
ADMIN_NAME=
# At least 10 characters.
ADMIN_PASSWORD=

# --- Backups --------------------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# Keep a copy somewhere safe (e.g. the company password manager). Without it, backups can't be restored.
BACKUP_PASSPHRASE=
# Hour of the day (0-23, Asia/Karachi) for the nightly backup. The HRM backs up at 2, so use 3.
BACKUP_HOUR=3
# Delete backups older than this many days.
BACKUP_KEEP_DAYS=30

# --- HTTPS ----------------------------------------------------------------------------------------
# The site is served over HTTPS by Caddy, so the sign-in cookie is marked Secure.
COOKIE_SECURE=1
